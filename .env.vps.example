# Required: create an app at https://my.telegram.org/apps
API_ID=
API_HASH=

# Required: generate locally with: python generate_string_session.py
# Treat this like a password. Never commit or share it.
STRING_SESSION=

# Required: use the key configured for your existing Nazriya API
NAZRIYA_API_KEY=
# Enter the API root with /api; code also normalizes a URL without /api.
NAZRIYA_API_BASE=https://nazriya.teamgod.online/api

# Optional tuning
MAX_DOWNLOAD_MB=500
LOG_LEVEL=INFO
