# ========================================================
# Piko Bot - Environment Variables Configuration
# ========================================================

# Telegram Bot Credentials
# Get this token from @BotFather on Telegram
BOT_TOKEN=

# Secret token passed in the 'X-Telegram-Bot-Api-Secret-Token' header by Telegram
WEBHOOK_SECRET=anonx_webhook_secret_key_32_chars

# Secret key required for admin endpoints (/config, /api/logs, /setwebhook, /cron)
# Must be at least 16 characters
ADMIN_SECRET=anonx_admin_secret_key_32_characters_long

# Bot Display Name
BOT_NAME=Piko

# Owner Telegram User ID (numeric ID)
OWNER_ID=8750122483

# Support Group Telegram URL
SUPPORT_GROUP=https://t.me/+lOxdvQHVCSdhZWU9

# --------------------------------------------------------
# Database Configuration (Turso libSQL)
# --------------------------------------------------------
# Leave empty to use built-in local SQLite in-memory database
TURSO_DB_URL=
TURSO_AUTH_TOKEN=

# --------------------------------------------------------
# Image Generation API (Optional)
# --------------------------------------------------------
IMAGE_API_URL=
IMAGE_API_KEY=

# --------------------------------------------------------
# Features & Tuning
# --------------------------------------------------------
MULTI_ANON=true
ANON_SHUFFLE_MODE=false
TOPIC_END_IDLE_MINUTES=10

# Groq AI chat and voice transcription
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_VOICE_MODEL=whisper-large-v3-turbo
